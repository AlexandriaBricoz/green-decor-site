# Скопируйте в .env на сервере и заполните.
# НЕ коммитьте .env в git.

# Django
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-64
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.ru,www.your-domain.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru
DJANGO_LOG_LEVEL=INFO

# HTTPS редирект: включён, но можно отключить, если nginx уже редиректит
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=2592000

# База данных (PostgreSQL)
DATABASE_URL=postgres://green_decor:STRONG_PASSWORD_HERE@127.0.0.1:5432/green_decor

# Место хранения загружаемых фото (вне репозитория)
DJANGO_MEDIA_ROOT=/var/lib/green-decor/media
