# Скопируйте в .env рядом с docker-compose.yml и заполните.
# НЕ коммитить .env в git.

# Домен сайта (без www) — используется и в labels Traefik, и в Django.
SITE_DOMAIN=greendecor056.ru

# --- База данных (используется и контейнером db, и Django) ---
POSTGRES_DB=green_decor
POSTGRES_USER=green_decor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Django ---
DJANGO_SECRET_KEY=GENERATE_WITH_python3_-c_import_secrets_secrets.token_urlsafe_64
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=greendecor056.ru,www.greendecor056.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://greendecor056.ru,https://www.greendecor056.ru
DJANGO_LOG_LEVEL=INFO
# Traefik уже делает HTTPS-редирект; на web-контейнере отключаем Django-редирект.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=2592000
# Внутри контейнера media лежит здесь (совпадает с volume).
DJANGO_MEDIA_ROOT=/app/media
# Django подключается к сервису `db` из compose (внутренняя сеть)
DATABASE_URL=postgres://green_decor:CHANGE_ME_STRONG_PASSWORD@db:5432/green_decor

# Количество gunicorn воркеров (опционально)
GUNICORN_WORKERS=3

# --- Telegram-бот (заявки в чат + /table) ---
# Пусто = бот выключен. Заполните все три и перезапустите web.
# 1) Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# 2) Случайная строка для проверки webhook (python -c 'import secrets; print(secrets.token_urlsafe(32))')
TELEGRAM_WEBHOOK_SECRET=
# 3) Публичный URL сайта (для setup_telegram_webhook)
TELEGRAM_BASE_URL=https://greendecor056.ru
# 4) Если сервер в РФ, api.telegram.org заблокирован. Поднимите Cloudflare Worker
#    и укажите его URL здесь (иначе оставьте пустым — тогда будет api.telegram.org).
TELEGRAM_API_BASE=
